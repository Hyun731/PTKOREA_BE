# 복사해서 같은 폴더에 .env 로 저장하세요:  cp .env.example .env
# .env 는 git에 올라가지 않습니다. 값은 채팅·문서에 붙이지 말고 이 파일에만 넣으세요.
# 비워 둔 키는 '미설정'으로 표시되고, 그 채널은 직접 입력·CSV로 진행합니다.

# --- 유료 API (단계 2에서 연결) ---
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
SCRAPECREATORS_API_KEY=

# --- 무료 API ---
YOUTUBE_API_KEY=

# --- Apify (선택, Actor를 정한 뒤) ---
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_ACTOR_BUILD=

# --- 실행 1회 비용 상한 (USD, 선택) — 비워 두면 상한 없음 ---
RUN_BUDGET_USD=

# --- 외부 공개 (터널로 백엔드를 열 때) ---
# 웹 서버(Vercel)의 BACKEND_TOKEN과 같은 값. 설정하면 /v1 요청은 X-Backend-Token 헤더가 있어야 합니다.
# BACKEND_TOKEN=

# ngrok 고정 도메인 (docker compose --profile tunnel up -d)
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=xxxx.ngrok-free.app

# --- 인프라 (비우면 개발 기본값: SQLite + 로컬 파일 + 스레드 작업) ---
# DATABASE_URL=postgresql+psycopg://ptk:ptk@localhost:5433/ptk
# REDIS_URL=redis://localhost:6380/0
# JOB_BACKEND=celery
# STORAGE_ROOT=
# RENDER_BACKEND=docker